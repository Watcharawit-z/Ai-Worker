# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (อย่า commit .env ขึ้น git)

# จำเป็นถ้าจะให้ AI ตอบคอมเมนท์ — ขอที่ https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# แจ้งเตือนผ่าน Telegram (ไม่ใส่ก็ได้ ระบบจะพิมพ์ลง terminal แทน)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# แจ้งเตือนผ่าน webhook — ใช้กับ Discord / Slack / n8n ได้
NOTIFY_WEBHOOK_URL=

# ระบุ config คนละไฟล์ต่อช่อง (เวลาคุมหลายช่องพร้อมกัน)
# AIWORKER_CONFIG=config/config.yaml
